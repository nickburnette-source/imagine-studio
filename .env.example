# Generation backend:
#   cli  — `grok login` session, or XAI_API_KEY if it is set  [default]
#   api  — XAI_API_KEY billing
#   stub — local placeholders, no Imagine call
IMAGINE_GENERATE_BACKEND=cli

# xAI Imagine. Optional for cli when `grok login` has been run.
XAI_API_KEY=

# Models. The studio does not edit these in the UI.
IMAGINE_IMAGE_MODEL=grok-imagine-image-quality
IMAGINE_VIDEO_MODEL=grok-imagine-video-1.5
IMAGINE_IMAGE_RESOLUTION=1k
IMAGINE_VIDEO_RESOLUTION=720p
IMAGINE_VIDEO_DURATION=6

# AWS identity for video staging.
# aws sso login --profile dutycall-dev
AWS_PROFILE=dutycall-dev
AWS_REGION=us-east-1

# Video is staged through S3 because Imagine will not host the file.
CONTENT_S3_BUCKET=
CONTENT_S3_PREFIX=staging/

# Local projects
IMAGINE_OUTPUT_DIR=./projects

# GUI. 8070 stays off Rally Builder (8080) and the clip editor (8090).
IMAGINE_HOST=127.0.0.1
IMAGINE_PORT=8070
# ./start.sh does not open a browser unless this is 1.
IMAGINE_OPEN_BROWSER=0
