# Imagine Studio. Copy this file to .env and fill in the bucket and keys.
#   cp .env.example .env

# How clips are made.
#   cli  — `grok login` on this machine (default)
#   api  — XAI_API_KEY
#   stub — offline placeholders, no AWS
RALLY_GENERATE_BACKEND=cli

# Only for RALLY_GENERATE_BACKEND=api
# XAI_API_KEY=

# One private S3 bucket in any AWS account.
# Video is uploaded here with a presigned URL, then downloaded into the project.
# Leave the bucket's public access blocked.
CONTENT_S3_BUCKET=
CONTENT_S3_PREFIX=staging/
AWS_REGION=us-east-1

# Access key for an IAM user on that account.
# The user needs, on this bucket only:
#   s3:ListBucket              on arn:aws:s3:::YOUR-BUCKET
#   s3:PutObject, s3:GetObject, s3:DeleteObject
#                              on arn:aws:s3:::YOUR-BUCKET/staging/*
# Uncomment and paste. Leave commented if `aws configure` already saved
# credentials for the default profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional named profile (`aws configure --profile NAME`). Not required
# when the access key above is set.
# AWS_PROFILE=

# This app. 8070 avoids the other local app on 8080.
RALLY_HOST=127.0.0.1
RALLY_PORT=8070
RALLY_OUTPUT_DIR=./rallies
